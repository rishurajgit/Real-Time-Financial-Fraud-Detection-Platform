# Paths (relative to ml_service/ or absolute)
SENTINEL_DATA_DIR="./data/raw"
SENTINEL_EDA_OUTPUT_DIR="./artifacts/eda"
SENTINEL_MODEL_OUTPUT_DIR="./artifacts/models/xgboost"

# Dataset & Splitting
SENTINEL_TRAIN_FRACTION="0.80"
SENTINEL_RANDOM_SEED="42"

# XGBoost Hyperparameters
SENTINEL_XGB_N_ESTIMATORS="600"
SENTINEL_XGB_MAX_DEPTH="6"
SENTINEL_XGB_LEARNING_RATE="0.05"
SENTINEL_XGB_SUBSAMPLE="0.80"
SENTINEL_XGB_COLSAMPLE_BYTREE="0.80"
SENTINEL_XGB_EARLY_STOPPING="40"

# MLflow Tracking (optional during Phase 1, active in Phase 5)
MLFLOW_TRACKING_URI="sqlite:///./mlflow.db"
MLFLOW_EXPERIMENT_NAME="sentinelrisk-ieee-cis-xgboost"
